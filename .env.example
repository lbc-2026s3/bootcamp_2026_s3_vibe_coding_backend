# Anvil / local RPC（监听建议 ws://，交易脚本会自动把 ws 转成 http）
RPC_URL=ws://127.0.0.1:8545

# Deployed NFTMarket address（forge script script/NFTMarket.s.sol）
NFT_MARKET_ADDRESS=0x...

# 挂单价（TOKEN，默认 10）
# LIST_PRICE=10

# 可选：默认使用 Anvil account#0 卖家、#1 买家
# SELLER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
# BUYER_PRIVATE_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d
