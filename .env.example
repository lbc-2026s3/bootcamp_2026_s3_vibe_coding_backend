# Anvil / Sepolia RPC（索引建议 ws://，回填会自动转成 http）
RPC_URL=ws://127.0.0.1:8545

# 命令行钱包发送方私钥（本地可用 Anvil account#0；切勿提交真实私钥）
PRIVATE_KEY=

# MyTokenERC1363 合约地址（forge script script/MyTokenERC1363.s.sol）
TOKEN_ADDRESS=

# MyTokenERC2612Permit 合约地址（forge script script/MyTokenERC2612Permit.s.sol）
TOKEN2612_ADDRESS=

# Uniswap Permit2（主网/Sepolia/多数 L2 同址 CREATE2）
# PERMIT2_ADDRESS=0x000000000022D473030F116dDEE9F6B43aC78BA3
PERMIT2_ADDRESS=

# TokenBankPermit2 绑定的 ERC20（forge script script/TokenBankPermit2.s.sol 部署的 MyTokenV1）
PERMIT2_TOKEN_ADDRESS=

# 合约部署区块（deployments/MyTokenERC1363/MyTokenERC1363_11155111.json 中的 blockNumber）
START_BLOCK=0

# 11155111 = Sepolia, 31337 = Anvil
# CHAIN_ID=11155111
CHAIN_ID=31337

# SQLite 数据库路径
DATABASE_PATH=./data/transfers.db

# Express API
PORT=3001
CORS_ORIGIN=http://localhost:3000
TOKEN_DECIMALS=18

# Deployed NFTMarket address（forge script script/NFTMarket.s.sol）
NFT_MARKET_ADDRESS=0x...

# 挂单价（TOKEN，默认 10）
# LIST_PRICE=10

# 可选：默认使用 Anvil account#0 卖家、#1 买家
# SELLER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
# BUYER_PRIVATE_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d
